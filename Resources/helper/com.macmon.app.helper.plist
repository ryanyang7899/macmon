<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.macmon.app.helper</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Library/PrivilegedHelperTools/com.macmon.app.helper</string>
	</array>
	<!-- MachServices 是 XPC 能连上来的前提 -->
	<key>MachServices</key>
	<dict>
		<key>com.macmon.app.helper</key>
		<true/>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<!-- 崩溃后自动重启; 重启时若上次锁着风扇会自行交还系统 -->
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
